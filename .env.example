# MySQL 连接串
DATABASE_URL="mysql://root:password@localhost:3306/hzpu_forum"

# JWT 会话密钥（生产环境必须替换为随机长字符串）
SESSION_SECRET="dev-only-secret-change-me"

# 站点品牌
NEXT_PUBLIC_SITE_NAME="HZPU 校园论坛"

# 学号正则（按 HZPU 实际学号格式修改，示例：2位年级+10位编号）
STUDENT_ID_PATTERN="^\\d{12}$"

# 可选：LLM 审核 agent 端点（留空则只用本地敏感词审核）
# MODERATION_LLM_URL="http://localhost:11434/api/generate"
# MODERATION_LLM_MODEL="qwen2"

# 上传目录（相对项目根，生产环境建议挂到数据盘）
UPLOAD_DIR="uploads"

# 仅内网访问（默认开启）
# true  = 只允许校园内网 / 本机来源访问，外网请求返回 403
# false = 对公网开放（境内服务器需自行完成 ICP 备案 + 公安联网备案）
# 注意：应用层只是兜底，真正的边界请用防火墙 / 反向代理 ACL 控制
INTRANET_ONLY="true"
