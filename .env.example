# MySQL 连接串
DATABASE_URL="mysql://root:password@localhost:3306/hzpu_forum"

# JWT 会话密钥（生产环境必须替换为随机长字符串）
SESSION_SECRET="dev-only-secret-change-me"

# 站点品牌
NEXT_PUBLIC_SITE_NAME="HZPU 校园论坛"

# 学号正则（按 HZPU 实际学号格式修改，示例：2位年级+10位编号）
STUDENT_ID_PATTERN="^\\d{12}$"

# 可选：LLM 审核 agent 端点（留空则只用本地敏感词审核）
# MODERATION_LLM_URL="http://localhost:11434/api/generate"
# MODERATION_LLM_MODEL="qwen2"

# 上传目录（相对项目根，生产环境建议挂到数据盘）
UPLOAD_DIR="uploads"

# 仅内网访问（默认开启）
# true  = 只允许校园内网 / 本机来源访问，外网请求返回 403
# false = 对公网开放（境内服务器需自行完成 ICP 备案 + 公安联网备案）
# 注意：应用层只是兜底，真正的边界请用防火墙 / 反向代理 ACL 控制
INTRANET_ONLY="true"

# ---------- 学校统一身份认证（SSO）----------
# 接入通道已预留：学校网络信息中心把地址与凭据给我们之后，只改这一段即可启用，无需改代码。
# 未启用（SSO_ENABLED 非 true 或 SSO_BASE_URL 为空）时，登录/注册页退回「学号 + 密码」方式。
SSO_ENABLED="false"
# 协议：cas（国内高校最常见）| oauth2（OAuth 2.0 / OIDC）
SSO_PROTOCOL="cas"
# IdP 根地址，例如 https://sso.hzpu.edu.cn
SSO_BASE_URL=""
# 各端点路径（默认值按协议给，学校给的路径不同时改这里）
SSO_LOGIN_PATH=""            # 留空 = cas 用 /login、oauth2 用 /oauth/authorize
SSO_VALIDATE_PATH="/serviceValidate"  # 仅 cas
SSO_TOKEN_PATH="/oauth/token"         # 仅 oauth2
SSO_USERINFO_PATH="/oauth/userinfo"   # 仅 oauth2
# 仅 oauth2 需要；client_secret 只能放在服务端，切勿加 NEXT_PUBLIC_ 前缀
SSO_CLIENT_ID=""
SSO_CLIENT_SECRET=""
SSO_SCOPE="openid profile"
# 回调地址：留空则按请求 Host 自动推导为 <origin>/api/auth/sso/callback
# 注意必须与 IdP 侧登记的地址完全一致，线上建议显式写死
SSO_REDIRECT_URI=""
# 登录按钮文案
SSO_LABEL="学校统一身份认证"
# IdP 用校内自签证书且暂时无法导入 CA 时设 true（仅在纯内网自建 IdP 场景使用）
SSO_TLS_INSECURE="false"
# IdP 返回的属性名 → 本系统字段的映射（各校叫法不同，照 IdP 文档填）
SSO_ATTR_STUDENT_ID="studentId"
SSO_ATTR_REAL_NAME="realName"
SSO_ATTR_NICKNAME="nickname"    # 有则作为初始昵称；没有则用「同学+学号后4位」
SSO_ATTR_COLLEGE="college"
SSO_ATTR_CLASS_NAME="className"
